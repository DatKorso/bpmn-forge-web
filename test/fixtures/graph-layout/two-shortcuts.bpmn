    </bpmn:endEvent>
    <bpmn:sequenceFlow id="StartToSplit" sourceRef="Start" targetRef="Split" />
    <bpmn:sequenceFlow id="FirstShortcut" sourceRef="Split" targetRef="MiddleTask" />
    <bpmn:sequenceFlow id="SplitToFirst" sourceRef="Split" targetRef="FirstTask" />
    <bpmn:sequenceFlow id="FirstToMiddle" sourceRef="FirstTask" targetRef="MiddleTask" />
    <bpmn:sequenceFlow id="SecondShortcut" sourceRef="MiddleTask" targetRef="Merge" />
    <bpmn:sequenceFlow id="LastToMerge" sourceRef="LastTask" targetRef="Merge" />
    <bpmn:sequenceFlow id="MergeToEnd" sourceRef="Merge" targetRef="End" />
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>SecondShortcut</bpmn:incoming>
      <bpmn:incoming>LastToMerge</bpmn:incoming>
      <bpmn:outgoing>MergeToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MiddleTask">
