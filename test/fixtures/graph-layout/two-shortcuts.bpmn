      <bpmn:incoming>FirstToMiddle</bpmn:incoming>
      <bpmn:outgoing>SecondShortcut</bpmn:outgoing>
      <bpmn:outgoing>MiddleToLast</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="MiddleToLast" sourceRef="MiddleTask" targetRef="LastTask" />
    <bpmn:task id="LastTask">
      <bpmn:incoming>MiddleToLast</bpmn:incoming>
      <bpmn:outgoing>LastToMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Split">
      <bpmn:incoming>StartToSplit</bpmn:incoming>
      <bpmn:outgoing>FirstShortcut</bpmn:outgoing>
      <bpmn:outgoing>SplitToFirst</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>StartToSplit</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
