<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="S" />
    <bpmn:task id="A" />
    <bpmn:boundaryEvent id="Event" attachedToRef="A" />
    <bpmn:endEvent id="T" />
    <bpmn:sequenceFlow id="SA" sourceRef="S" targetRef="A" />
    <bpmn:sequenceFlow id="AT" sourceRef="A" targetRef="T" />
    <bpmn:sequenceFlow id="AA" sourceRef="A" targetRef="A" />
    <bpmn:sequenceFlow id="EA" sourceRef="Event" targetRef="A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="20" y="30" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="165" y="75" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_di" bpmnElement="Event">
        <dc:Bounds x="230" y="138" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_di" bpmnElement="T">
        <dc:Bounds x="455" y="75" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SA_di" bpmnElement="SA">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_di" bpmnElement="AT">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AA_di" bpmnElement="AA">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EA_di" bpmnElement="EA">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
