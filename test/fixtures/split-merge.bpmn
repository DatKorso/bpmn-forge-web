<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:exclusiveGateway id="Split" default="Main" />
    <bpmn:task id="A" />
    <bpmn:task id="B" />
    <bpmn:exclusiveGateway id="Join" />
    <bpmn:sequenceFlow id="Main" sourceRef="Split" targetRef="A" />
    <bpmn:sequenceFlow id="Branch" sourceRef="Split" targetRef="B" />
    <bpmn:sequenceFlow id="JoinA" sourceRef="A" targetRef="Join" />
    <bpmn:sequenceFlow id="JoinB" sourceRef="B" targetRef="Join" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="40" y="165" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="157" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_di" bpmnElement="B">
        <dc:Bounds x="160" y="284" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="329" y="143" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Main_di" bpmnElement="Main">
        <di:waypoint x="65" y="165" />
        <di:waypoint x="65" y="130" />
        <di:waypoint x="157" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Branch_di" bpmnElement="Branch">
        <di:waypoint x="65" y="215" />
        <di:waypoint x="65" y="324" />
        <di:waypoint x="160" y="324" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="JoinA_di" bpmnElement="JoinA">
        <di:waypoint x="257" y="130" />
        <di:waypoint x="354" y="130" />
        <di:waypoint x="354" y="143" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="JoinB_di" bpmnElement="JoinB">
        <di:waypoint x="260" y="324" />
        <di:waypoint x="354" y="324" />
        <di:waypoint x="354" y="193" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
