<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Обработка инцидентов" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
    <bpmn:lane id="Support" name="Поддержка">
      <bpmn:flowNodeRef>Opened</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Triage</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Solve</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Resolved</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="OnCall" name="Дежурная команда">
      <bpmn:flowNodeRef>Investigate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Sla</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Escalate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
    </bpmn:lane>
  </bpmn:laneSet>
    <bpmn:startEvent id="Opened" />
    <bpmn:userTask id="Triage" name="Оценить критичность" />
    <bpmn:task id="Solve" name="Закрыть типовой инцидент" />
    <bpmn:endEvent id="Resolved" />
    <bpmn:userTask id="Investigate" name="Разобрать инцидент" />
    <bpmn:boundaryEvent id="Sla" attachedToRef="Investigate" cancelActivity="false">
    <bpmn:timerEventDefinition id="SlaDefinition">
      <bpmn:timeDuration>PT45M</bpmn:timeDuration>
    </bpmn:timerEventDefinition>
  </bpmn:boundaryEvent>
    <bpmn:sendTask id="Escalate" name="Эскалировать" />
    <bpmn:endEvent id="Closed" />
    <bpmn:sequenceFlow id="ToTriage" sourceRef="Opened" targetRef="Triage" />
    <bpmn:sequenceFlow id="Typical" sourceRef="Triage" targetRef="Solve" />
    <bpmn:sequenceFlow id="Severe" sourceRef="Triage" targetRef="Investigate" />
    <bpmn:sequenceFlow id="ClosedNormally" sourceRef="Solve" targetRef="Resolved" />
    <bpmn:sequenceFlow id="ClosedByOnCall" sourceRef="Investigate" targetRef="Closed" />
    <bpmn:sequenceFlow id="SlaExceeded" sourceRef="Sla" targetRef="Escalate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="false">
        <dc:Bounds x="0" y="0" width="630" height="930" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Support_di" bpmnElement="Support" isHorizontal="false">
        <dc:Bounds x="0" y="30" width="300" height="900" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OnCall_di" bpmnElement="OnCall" isHorizontal="false">
        <dc:Bounds x="300" y="30" width="330" height="900" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Opened_di" bpmnElement="Opened">
        <dc:Bounds x="170" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Triage_di" bpmnElement="Triage">
        <dc:Bounds x="102" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Solve_di" bpmnElement="Solve">
        <dc:Bounds x="145" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Resolved_di" bpmnElement="Resolved">
        <dc:Bounds x="146" y="700" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Investigate_di" bpmnElement="Investigate">
        <dc:Bounds x="435" y="419" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sla_di" bpmnElement="Sla">
        <dc:Bounds x="516" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate">
        <dc:Bounds x="450" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Closed_di" bpmnElement="Closed">
        <dc:Bounds x="367" y="748" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ToTriage_di" bpmnElement="ToTriage">
        <di:waypoint x="188" y="116" />
        <di:waypoint x="188" y="160" />
        <di:waypoint x="152" y="160" />
        <di:waypoint x="152" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Typical_di" bpmnElement="Typical">
        <di:waypoint x="152" y="280" />
        <di:waypoint x="152" y="358" />
        <di:waypoint x="195" y="358" />
        <di:waypoint x="195" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Severe_di" bpmnElement="Severe">
        <di:waypoint x="202" y="240" />
        <di:waypoint x="485" y="240" />
        <di:waypoint x="485" y="419" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ClosedNormally_di" bpmnElement="ClosedNormally">
        <di:waypoint x="195" y="500" />
        <di:waypoint x="195" y="610" />
        <di:waypoint x="164" y="610" />
        <di:waypoint x="164" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ClosedByOnCall_di" bpmnElement="ClosedByOnCall">
        <di:waypoint x="485" y="499" />
        <di:waypoint x="485" y="553" />
        <di:waypoint x="385" y="553" />
        <di:waypoint x="385" y="748" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SlaExceeded_di" bpmnElement="SlaExceeded">
        <di:waypoint x="534" y="498" />
        <di:waypoint x="534" y="555" />
        <di:waypoint x="500" y="555" />
        <di:waypoint x="500" y="620" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
