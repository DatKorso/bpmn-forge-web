<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Подключение поставщика" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Request" />
    <bpmn:subProcess id="Onboarding" name="Подключить поставщика">
    <bpmn:task id="Collect" name="Собрать документы" />
    <bpmn:transaction id="Contract" name="Согласовать договор">
      <bpmn:userTask id="Draft" name="Подготовить договор" />
      <bpmn:userTask id="Sign" name="Подписать договор" />
      <bpmn:sequenceFlow id="ToSign" sourceRef="Draft" targetRef="Sign" />
    </bpmn:transaction>
    <bpmn:task id="Activate" name="Активировать поставщика" />
    <bpmn:sequenceFlow id="ToContract" sourceRef="Collect" targetRef="Contract" />
    <bpmn:sequenceFlow id="ToActivate" sourceRef="Contract" targetRef="Activate" />
    <bpmn:dataObject id="ContractRecord" />
    <bpmn:dataObjectReference id="ContractData" dataObjectRef="ContractRecord" />
    <bpmn:textAnnotation id="Checklist">
      <bpmn:text>Проверить регистрационные документы</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CheckDocs" sourceRef="Collect" targetRef="Checklist" />
  </bpmn:subProcess>
    <bpmn:callActivity id="Audit" name="Проверка службой контроля" />
    <bpmn:endEvent id="Complete" />
    <bpmn:sequenceFlow id="StartOnboarding" sourceRef="Request" targetRef="Onboarding" />
    <bpmn:sequenceFlow id="AuditSupplier" sourceRef="Onboarding" targetRef="Audit" />
    <bpmn:sequenceFlow id="PublishSupplier" sourceRef="Audit" targetRef="Complete" />
    <bpmn:dataStoreReference id="Directory" name="Реестр поставщиков" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1400" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_di" bpmnElement="Request">
        <dc:Bounds x="91" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Onboarding_di" bpmnElement="Onboarding" isExpanded="true">
        <dc:Bounds x="220" y="120" width="820" height="465" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Collect_di" bpmnElement="Collect">
        <dc:Bounds x="278" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Contract_di" bpmnElement="Contract" isExpanded="true">
        <dc:Bounds x="435" y="225" width="335" height="225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Draft_di" bpmnElement="Draft">
        <dc:Bounds x="485" y="278" width="100" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sign_di" bpmnElement="Sign">
        <dc:Bounds x="640" y="336" width="100" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activate_di" bpmnElement="Activate">
        <dc:Bounds x="855" y="259" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ContractData_di" bpmnElement="ContractData">
        <dc:Bounds x="713" y="500" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Checklist_di" bpmnElement="Checklist">
        <dc:Bounds x="255" y="183" width="150" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Audit_di" bpmnElement="Audit">
        <dc:Bounds x="1124" y="337" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Directory_di" bpmnElement="Directory">
        <dc:Bounds x="1186" y="475" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Complete_di" bpmnElement="Complete">
        <dc:Bounds x="1320" y="319" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="StartOnboarding_di" bpmnElement="StartOnboarding">
        <di:waypoint x="127" y="358" />
        <di:waypoint x="160" y="358" />
        <di:waypoint x="160" y="352" />
        <di:waypoint x="220" y="352" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AuditSupplier_di" bpmnElement="AuditSupplier">
        <di:waypoint x="1040" y="352" />
        <di:waypoint x="1082" y="352" />
        <di:waypoint x="1082" y="377" />
        <di:waypoint x="1124" y="377" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PublishSupplier_di" bpmnElement="PublishSupplier">
        <di:waypoint x="1224" y="377" />
        <di:waypoint x="1277" y="377" />
        <di:waypoint x="1277" y="337" />
        <di:waypoint x="1320" y="337" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToContract_di" bpmnElement="ToContract">
        <di:waypoint x="378" y="325" />
        <di:waypoint x="410" y="325" />
        <di:waypoint x="410" y="337" />
        <di:waypoint x="435" y="337" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToSign_di" bpmnElement="ToSign">
        <di:waypoint x="585" y="313" />
        <di:waypoint x="610" y="313" />
        <di:waypoint x="610" y="371" />
        <di:waypoint x="640" y="371" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToActivate_di" bpmnElement="ToActivate">
        <di:waypoint x="770" y="337" />
        <di:waypoint x="811" y="337" />
        <di:waypoint x="811" y="299" />
        <di:waypoint x="855" y="299" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CheckDocs_di" bpmnElement="CheckDocs">
        <di:waypoint x="328" y="285" />
        <di:waypoint x="328" y="233" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
