<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:sequenceFlow id="CloseLoop" sourceRef="Rework" targetRef="Verify" />
    <bpmn:sequenceFlow id="Enter" sourceRef="Prepare" targetRef="Verify" />
    <bpmn:sequenceFlow id="Across" sourceRef="Verify" targetRef="Split" />
    <bpmn:sequenceFlow id="Proceed" sourceRef="Split" targetRef="Continue" />
    <bpmn:exclusiveGateway id="Split">
      <bpmn:incoming>Across</bpmn:incoming>
      <bpmn:outgoing>Proceed</bpmn:outgoing>
      <bpmn:outgoing>BackToTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Continue">
      <bpmn:incoming>Proceed</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Prepare">
      <bpmn:outgoing>Enter</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Verify">
      <bpmn:incoming>CloseLoop</bpmn:incoming>
      <bpmn:incoming>Enter</bpmn:incoming>
      <bpmn:outgoing>Across</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Rework">
      <bpmn:incoming>BackToTask</bpmn:incoming>
      <bpmn:outgoing>CloseLoop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="BackToTask" sourceRef="Split" targetRef="Rework" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="false">
        <dc:Bounds x="1810" y="580" width="1680" height="3150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="2085" y="1435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Continue_di" bpmnElement="Continue">
        <dc:Bounds x="2070" y="1600" width="80" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prepare_di" bpmnElement="Prepare">
        <dc:Bounds x="2070" y="1050" width="80" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Verify_di" bpmnElement="Verify">
        <dc:Bounds x="2085" y="1265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rework_di" bpmnElement="Rework">
        <dc:Bounds x="1950" y="1240" width="80" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="CloseLoop_di" bpmnElement="CloseLoop">
        <di:waypoint x="2030" y="1290" />
        <di:waypoint x="2085" y="1290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Enter_di" bpmnElement="Enter">
        <di:waypoint x="2110" y="1150" />
        <di:waypoint x="2110" y="1265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Across_di" bpmnElement="Across">
        <di:waypoint x="2110" y="1315" />
        <di:waypoint x="2110" y="1435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Proceed_di" bpmnElement="Proceed">
        <di:waypoint x="2110" y="1485" />
        <di:waypoint x="2110" y="1600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BackToTask_di" bpmnElement="BackToTask">
        <di:waypoint x="2085" y="1460" />
        <di:waypoint x="1990" y="1460" />
        <di:waypoint x="1990" y="1340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
