<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:task id="A"><bpmn:dataInputAssociation id="Read"><bpmn:sourceRef>D</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
    <bpmn:task id="B"><bpmn:dataOutputAssociation id="Write"><bpmn:targetRef>D</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="WriteObject"><bpmn:targetRef>O</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:dataStoreReference id="D" />
    <bpmn:dataObject id="Object" />
    <bpmn:dataObjectReference id="O" dataObjectRef="Object" />
    <bpmn:sequenceFlow id="AB" sourceRef="A" targetRef="B" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="20" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_di" bpmnElement="B">
        <dc:Bounds x="165" y="75" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_di" bpmnElement="D">
        <dc:Bounds x="310" y="30" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="O_di" bpmnElement="O">
        <dc:Bounds x="600" y="30" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="AB_di" bpmnElement="AB">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Read_di" bpmnElement="Read">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Write_di" bpmnElement="Write">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WriteObject_di" bpmnElement="WriteObject">
        <di:waypoint x="180" y="92" />
        <di:waypoint x="310" y="92" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
