<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Start" />
    <bpmn:task id="Work" />
    <bpmn:endEvent id="End" />
    <bpmn:sequenceFlow id="Begin" sourceRef="Start" targetRef="Work" />
    <bpmn:sequenceFlow id="Finish" sourceRef="Work" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="false">
        <dc:Bounds x="0" y="0" width="330" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="80" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Work_di" bpmnElement="Work">
        <dc:Bounds x="145" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="86" y="370" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Begin_di" bpmnElement="Begin">
        <di:waypoint x="98" y="116" />
        <di:waypoint x="98" y="151" />
        <di:waypoint x="195" y="151" />
        <di:waypoint x="195" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Finish_di" bpmnElement="Finish">
        <di:waypoint x="195" y="270" />
        <di:waypoint x="195" y="325" />
        <di:waypoint x="104" y="325" />
        <di:waypoint x="104" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
