<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions" targetNamespace="https://example.org/bpmn">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:task id="Work" />
    <bpmn:task id="Next" />
    <bpmn:endEvent id="Escalate" />
    <bpmn:boundaryEvent id="Timer" attachedToRef="Work"><bpmn:timerEventDefinition /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Success" sourceRef="Work" targetRef="Next" />
    <bpmn:sequenceFlow id="Timeout" sourceRef="Timer" targetRef="Escalate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Work_di" bpmnElement="Work">
        <dc:Bounds x="92" y="101" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Next_di" bpmnElement="Next">
        <dc:Bounds x="289" y="144" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_di" bpmnElement="Timer">
        <dc:Bounds x="148" y="163" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate">
        <dc:Bounds x="300" y="281" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Success_di" bpmnElement="Success">
        <di:waypoint x="192" y="141" />
        <di:waypoint x="235" y="141" />
        <di:waypoint x="235" y="184" />
        <di:waypoint x="289" y="184" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Timeout_di" bpmnElement="Timeout">
        <di:waypoint x="166" y="199" />
        <di:waypoint x="166" y="299" />
        <di:waypoint x="300" y="299" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
